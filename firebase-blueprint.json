{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User account information and usage statistics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique Firebase Authentication UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "photoURL": { "type": "string", "description": "Profile picture URL from Google or custom upload" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin", "parent"], "description": "Assigned or selected portal user role" },
        "profileCompleted": { "type": "boolean", "description": "Indicates if user has completed first-time profile setup" },
        "isVerified": { "type": "boolean", "description": "Verification status confirmed strictly by an admin or teacher" },
        "verifiedBy": { "type": "string", "description": "Name or UID of verifying teacher or admin" },
        "verifiedAt": { "type": "string", "format": "date-time", "description": "Timestamp when verified" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "address": { "type": "string", "description": "Residential or communication address" },
        "dob": { "type": "string", "description": "Date of birth" },
        "gender": { "type": "string", "description": "Gender identification" },
        "studentId": { "type": "string", "description": "Student registration/roll identifier" },
        "classId": { "type": "string", "description": "Assigned class or grade section" },
        "guardianName": { "type": "string", "description": "Parent or legal guardian name for student" },
        "teacherId": { "type": "string", "description": "Teacher/Faculty employee ID" },
        "qualification": { "type": "string", "description": "Academic credentials and degree" },
        "subject": { "type": "string", "description": "Primary teaching subject specialization" },
        "childName": { "type": "string", "description": "Student ward name for parent profile" },
        "relationship": { "type": "string", "description": "Relationship to student (Father, Mother, Guardian)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last login timestamp" },
        "storageUsedBytes": { "type": "number", "description": "Total storage used in bytes" },
        "fileCount": { "type": "number", "description": "Total number of files stored" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "userFile": {
      "title": "User File",
      "description": "File metadata, upload date, and content data belonging strictly to a specific user",
      "type": "object",
      "properties": {
        "fileId": { "type": "string", "description": "Unique file identifier" },
        "userId": { "type": "string", "description": "Owner Firebase Authentication UID" },
        "name": { "type": "string", "description": "Original file name" },
        "size": { "type": "number", "description": "File size in bytes" },
        "mimeType": { "type": "string", "description": "MIME type of the file" },
        "uploadDate": { "type": "string", "format": "date-time", "description": "Upload timestamp" },
        "fileData": { "type": "string", "description": "File payload (Base64 data URL or storage URL)" },
        "downloadUrl": { "type": "string", "description": "Firebase Storage public download URL if stored in cloud bucket" },
        "storagePath": { "type": "string", "description": "Firebase Storage bucket object path" },
        "category": { "type": "string", "description": "Category or folder tag for the file" },
        "description": { "type": "string", "description": "Optional notes or description for the file" }
      },
      "required": ["fileId", "userId", "name", "size", "mimeType", "uploadDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile and account information document"
    },
    "/users/{userId}/files/{fileId}": {
      "schema": "userFile",
      "description": "User uploaded file metadata and file data storage"
    }
  }
}
